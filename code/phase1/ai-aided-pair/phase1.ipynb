    "from degradation_analysis import image_metrics, LPIPSScorer\n",
    "lpip = LPIPSScorer(device=device)\n",
    "\n",
    "sample = samples[0]\n",
    "print(sample.name)\n",
    "img, mask = load_sample(sample)\n",
    "\n",
    "# cell diam. \n",
    "def process_sample(img, mask):\n",
    "    props = regionprops(mask.astype(int))\n",
    "    diams = np.array([2 * np.sqrt(p.area / np.pi) for p in props]) # assume: cell is circle\n",
    "    diam = np.median(diams) if len(diams)> 0 else 30\n",
    "    \n",
    "    # --- Denoising: jeden Kanal einzeln, ohne den 30/17-Sonderweg ---\n",
    "    def denoise_channel(image, c):            # c: 1=R, 2=G, 3=B\n",
    "        out = dn_model.eval([image], channels=[c, 0], diameter=diam)[0]\n",
    "        return np.squeeze(out)\n",
    "    \n",
    "    cyto_dn = denoise_channel(img, 2)\n",
    "    nuc_dn  = denoise_channel(img, 1)\n",
    "    img_dn  = np.stack([cyto_dn, nuc_dn], axis=-1)   # [Zytoplasma, Kern]\n",
    "    print(\"Shape Original:\", img.shape, \"| Shape denoised:\", img_dn.shape)  # erwartet (H, W, 2)\n",
    "    \n",
    "    # --- Segmentierung ---\n",
    "    kw = dict(diameter=diam, flow_threshold=0.4, cellprob_threshold=0.0)\n",
    "    masks_dn,  _, _ = seg_model.eval(img_dn, channels=[1, 2], **kw)  # Index 1 = Zytoplasma, 2 = Kern\n",
    "    masks_raw, _, _ = seg_model.eval(img,    channels=[2, 1], **kw)  # Original: G=2, R=1\n",
    "    return masks_raw, masks_dn, img_dn[...,[1,0]]\n",
    "\n",
    "\n",
    "# --- Visualisierung ---\n",
    "def vis_masks(img, img_dn, mask, masks_raw, masks_dn):\n",
    "    def to_display(img, low=1, high=99):\n",
    "        \"\"\"Scale each channel to float [0, 1] with percentiles so imshow works for any dtype/range.\"\"\"\n",
    "        x = np.asarray(img, dtype=np.float32)\n",
    "        if x.ndim == 2:\n",
    "            x = x[..., None]\n",
    "        out = np.zeros_like(x)\n",
    "        for c in range(x.shape[-1]):\n",
    "            lo, hi = np.percentile(x[..., c], [low, high])\n",
    "            out[..., c] = np.clip((x[..., c] - lo) / max(hi - lo, 1e-6), 0, 1)\n",
    "        if out.shape[-1] == 2:  # add an empty third channel for RGB display\n",
    "            out = np.concatenate([out, np.zeros_like(out[..., :1])], axis=-1)\n",
    "        return out[..., 0] if out.shape[-1] == 1 else out\n",
    "    \n",
    "    def show_with_labels(ax, base, labels, title):\n",
    "        ax.imshow(to_display(base), cmap=\"gray\")\n",
    "        ax.imshow(np.ma.masked_equal(labels, 0), cmap=\"nipy_spectral\", alpha=0.5, interpolation=\"nearest\")\n",
    "        ax.set_title(title)\n",
    "    \n",
    "    fig, axes = plt.subplots(1, 5, figsize=(25, 5))\n",
    "    axes[0].imshow(to_display(img), cmap=\"gray\");    axes[0].set_title(\"1. Original\")\n",
    "    axes[1].imshow(to_display(img_dn), cmap=\"gray\"); axes[1].set_title(\"2. Denoised\")\n",
    "    show_with_labels(axes[2], img_dn, masks_dn,  f\"3. Seg. with Denoise ({masks_dn.max()} cells)\")\n",
    "    show_with_labels(axes[3], img,    masks_raw, f\"4. Seg. without Denoise ({masks_raw.max()} cells)\")\n",
    "    show_with_labels(axes[4], img,    mask,      f\"5. Ground Truth ({len(np.unique(mask)) - 1} cells)\")\n",
    "    for ax in axes:\n",
    "        ax.axis(\"off\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "mask_raw, mask_dn, img_dn = process_sample(img,mask)\n",
    "vis_masks(img,img_dn, mask,mask_raw, mask_dn)\n",
    "print(\"double denoise\")\n",
    "mask_raw, mask_dn, img_dn2 = process_sample(img_dn,mask)\n",
    "img_metric_1 = image_metrics(img[:,:,:-1].squeeze(), img_dn,lpip,\"clip\")\n",
    "img_metric_2 = image_metrics(img_dn, img_dn2,lpip,\"clip\")\n",
    "print(f\"original -> denoise 1: {img_metric_1} \\n denoise 1 -> denoise 2: {img_metric_2}\")\n",
    "vis_masks(img_dn,img_dn2, mask,mask_raw, mask_dn)"
   ]
